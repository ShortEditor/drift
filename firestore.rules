rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function owner(uid) { return request.auth != null && request.auth.uid == uid; }
  match /users/{uid}/likes/{trackId} {
   allow read, delete: if owner(uid);
   allow create, update: if owner(uid)
    && request.resource.data.keys().hasAll(['id','title','artistName','likedAt'])
    && request.resource.data.keys().hasOnly(['id','title','artistName','likedAt'])
    && request.resource.data.id is int && request.resource.data.id > 0
    && trackId == string(request.resource.data.id)
    && request.resource.data.title is string && request.resource.data.title.size() <= 500
    && request.resource.data.artistName is string && request.resource.data.artistName.size() <= 300
    && request.resource.data.likedAt is number && request.resource.data.likedAt > 0;
  }
  match /users/{uid}/preferences/discovery {
   allow read, delete: if owner(uid);
   allow create, update: if owner(uid)
    && request.resource.data.keys().hasAll(['genre','mood','query'])
    && request.resource.data.keys().hasOnly(['genre','mood','query'])
    && request.resource.data.genre is int && request.resource.data.genre >= 0
    && request.resource.data.mood is string && request.resource.data.mood.size() <= 50
    && request.resource.data.query is string && request.resource.data.query.size() <= 200;
  }
  match /{document=**} { allow read, write: if false; }
 }
}
